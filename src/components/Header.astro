---
// Componente de navegación superior de GobernaIA
// Ruta en repositorio: web/src/components/Header.astro
// Justificación: Presenta la identidad de marca, navegación principal por audiencias, equipo y llamada a la acción principal.
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-goberna-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logotipo oficial de GobernaIA -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-goberna-red rounded-lg p-1">
        <img 
          src="/logos/gobernaia-escudo.png" 
          alt="GobernaIA" 
          class="h-10 w-auto object-contain transition-transform group-hover:scale-105"
        />
        <div class="flex flex-col">
          <span class="text-2xl font-bold tracking-tight text-goberna-dark">
            Goberna<span class="text-goberna-red">IA</span>
          </span>
          <span class="text-[10px] uppercase tracking-wider font-semibold text-goberna-muted -mt-1">
            Gobernanza & Trazabilidad
          </span>
        </div>
      </a>

      <!-- Enlaces de navegación de escritorio -->
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-goberna-subtle">
        <a href="/#para-gestoras" class="hover:text-goberna-red transition-colors">
          Para Gestoras
        </a>
        <a href="/#plataforma" class="hover:text-goberna-red transition-colors">
          Plataforma
        </a>
        <a href="/#ciclo-de-vida" class="hover:text-goberna-red transition-colors">
          Ciclo de Vida
        </a>
        <a href="/#equipo" class="hover:text-goberna-red transition-colors">
          Equipo
        </a>
        <a href="/#metodo" class="hover:text-goberna-red transition-colors">
          Gobernanza Real
        </a>
        <a href="/#faq" class="hover:text-goberna-red transition-colors">
          Preguntas
        </a>
      </nav>

      <!-- Botones de acción y acceso -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="https://stage.gobernaia.tarsisuniverse.com/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-3.5 py-2 text-xs font-semibold text-goberna-subtle hover:text-goberna-dark hover:bg-gray-100 rounded-lg transition-colors"
        >
          Acceso Clientes
        </a>
        <a href="/#contacto" class="btn-primary">
          Hablar con el equipo
        </a>
      </div>

      <!-- Menú móvil (botón hamburguesa) -->
      <div class="md:hidden flex items-center">
        <a href="/#contacto" class="btn-primary text-xs px-3 py-1.5 mr-2">
          Contactar
        </a>
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="p-2 rounded-lg text-goberna-subtle hover:text-goberna-dark hover:bg-gray-100 focus:outline-none"
          aria-label="Abrir menú"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Desplegable móvil -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-goberna-border bg-white px-4 pt-2 pb-4 space-y-2 text-sm font-medium">
    <a href="/#para-gestoras" class="block py-2 text-goberna-subtle hover:text-goberna-red">Para Gestoras</a>
    <a href="/#plataforma" class="block py-2 text-goberna-subtle hover:text-goberna-red">Plataforma</a>
    <a href="/#ciclo-de-vida" class="block py-2 text-goberna-subtle hover:text-goberna-red">Ciclo de Vida</a>
    <a href="/#equipo" class="block py-2 text-goberna-subtle hover:text-goberna-red">Equipo</a>
    <a href="/#metodo" class="block py-2 text-goberna-subtle hover:text-goberna-red">Gobernanza Real</a>
    <a href="/#faq" class="block py-2 text-goberna-subtle hover:text-goberna-red">Preguntas</a>
    <div class="pt-3 border-t border-gray-100 flex flex-col gap-2">
      <a 
        href="https://stage.gobernaia.tarsisuniverse.com/" 
        target="_blank" 
        class="text-center py-2 text-xs font-semibold text-goberna-subtle bg-gray-50 rounded-lg"
      >
        Acceso Clientes
      </a>
      <a href="/#contacto" class="btn-primary text-center">
        Hablar con el equipo
      </a>
    </div>
  </div>
</header>

<script>
  // Control de apertura y cierre del menú móvil
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
