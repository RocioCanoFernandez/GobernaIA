---
const team = [
  {
    name: "Rocío Cano",
    role: "Dirección de Producto y Estrategia Operativa",
    company: "Fundadora de SeviAI",
    bio: "Lidera la visión de producto, la metodología de implantación y la coordinación entre negocio, tecnología y especialistas.",
    area: "Producto",
    photo: "/team/rocio-cano-goberna.webp"
  },
  {
    name: "Pepe Salgado",
    role: "Dirección Técnica y Arquitectura Cloud",
    company: "Desarrollo de GobernaIA",
    bio: "Dirige el desarrollo técnico de la nueva arquitectura y la evolución de la plataforma hacia un entorno seguro y escalable.",
    area: "Tecnología",
    photo: "/team/pepe-salgado-goberna.webp"
  },
  {
    name: "Amal Ezzeddine",
    role: "Validación jurídica en IA",
    company: "RZS Abogados",
    bio: "Participa junto al equipo jurídico de RZS en la revisión funcional y legal del producto y en su contraste con casos prácticos.",
    area: "Derecho de IA",
    photo: "/team/amal-ezzeddine-goberna.webp"
  },
  {
    name: "Natalia Álvarez",
    role: "Equipo jurídico colaborador",
    company: "RZS Abogados",
    bio: "Aporta criterio jurídico al proceso de validación y a la conexión entre los requisitos normativos y el trabajo de las organizaciones.",
    area: "Validación jurídica",
    photo: "/team/natalia-alvarez-goberna.webp"
  }
];
---

<section id="equipo" class="py-20 bg-white border-b border-goberna-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-red-50 text-xs font-semibold text-goberna-red-dark">
        Equipo & colaboración especializada
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-goberna-dark tracking-tight">
        Producto, tecnología y criterio jurídico en la misma mesa.
      </h2>
      <p class="text-base sm:text-lg text-goberna-muted leading-relaxed">
        GobernaIA se construye combinando dirección de producto, ingeniería y validación jurídica especializada. Las decisiones de software se contrastan con la práctica profesional antes de convertirlas en flujos de trabajo.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {team.map((member) => (
        <article class="group bg-gray-50/70 border border-gray-200 rounded-3xl overflow-hidden hover:shadow-card-hover hover:border-red-200 transition-all">
          <div class="relative aspect-[4/4.25] overflow-hidden bg-gray-100">
            <img
              src={member.photo}
              alt={`Retrato de ${member.name}`}
              loading="lazy"
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.025]"
            />
            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-gray-950/65 to-transparent"></div>
            <span class="absolute left-4 bottom-4 text-[10px] font-bold uppercase tracking-wider text-white bg-goberna-red/90 px-2.5 py-1 rounded-full">
              {member.area}
            </span>
          </div>

          <div class="p-5 space-y-3">
            <div>
              <h3 class="text-lg font-extrabold text-goberna-dark">{member.name}</h3>
              <p class="text-xs font-semibold text-goberna-red mt-1">{member.role}</p>
              <p class="text-[11px] font-medium text-gray-400 mt-1">{member.company}</p>
            </div>
            <p class="text-xs text-goberna-muted leading-relaxed pt-3 border-t border-gray-200/80">
              {member.bio}
            </p>
          </div>
        </article>
      ))}
    </div>

    <div class="bg-gradient-to-r from-gray-950 via-gray-900 to-gray-950 rounded-3xl p-8 sm:p-10 text-white flex flex-col lg:flex-row items-center justify-between gap-8 shadow-xl">
      <div class="space-y-3 max-w-2xl text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/20 text-red-200 text-xs font-bold border border-red-500/30">
          Colaboración activa
        </div>
        <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
          Validación jurídica conectada con la evolución del producto.
        </h3>
        <p class="text-sm text-gray-300 leading-relaxed">
          RZS Abogados aporta casos, conocimiento jurídico y revisión funcional para comprobar que GobernaIA responde a procesos reales. Esta colaboración refuerza el producto, sin convertir la plataforma en sustituto del asesoramiento profesional.
        </p>
      </div>

      <div class="flex-shrink-0 flex flex-col sm:flex-row items-center gap-4">
        <div class="px-6 py-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/15 text-center">
          <div class="text-xs text-gray-400 font-medium">Entidad colaboradora</div>
          <div class="text-lg font-bold tracking-wider text-white">RZS ABOGADOS</div>
        </div>
        <a href="#contacto" class="btn-primary whitespace-nowrap text-sm px-6 py-3.5">
          Hablar con el equipo
        </a>
      </div>
    </div>
  </div>
</section>
